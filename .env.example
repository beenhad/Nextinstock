# Nextinstock can read the existing SellerMaid eBay credentials without copying
# them. Point this at SellerMaid's private dotenv file, or define the EBAY_*
# values directly below.
SELLERMAID_ENV_FILE=

EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_REDIRECT_RU_NAME=
EBAY_REFRESH_TOKEN=

# One supported MVP listing can be preselected in the task builder.
NEXTINSTOCK_ITEM_ID=266994813467

# Local is durable on the Mac. Vercel's filesystem is ephemeral.
NEXTINSTOCK_STORAGE_DRIVER=local
NEXTINSTOCK_DATA_DIR=

# dry-run never uploads or revises a live eBay listing.
# Change to live only after reconnecting eBay with sell.inventory permission.
NEXTINSTOCK_EBAY_WRITE_MODE=dry-run
NEXTINSTOCK_POLL_SECONDS=30
