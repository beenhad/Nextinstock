# Enter your own eBay developer credentials. Keep this file private.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_REDIRECT_RU_NAME=
EBAY_REFRESH_TOKEN=

# Optional listing ID to prefill in the task builder.
NEXTINSTOCK_ITEM_ID=

# Local is durable on the Mac. Vercel's filesystem is ephemeral.
NEXTINSTOCK_STORAGE_DRIVER=local
NEXTINSTOCK_DATA_DIR=

# dry-run never uploads or revises a live eBay listing.
# Change to live only after reconnecting eBay with sell.inventory permission.
NEXTINSTOCK_EBAY_WRITE_MODE=dry-run
NEXTINSTOCK_POLL_SECONDS=30
NEXTINSTOCK_RESTOCK_DELAY_SECONDS=60

# Stripe test checkout. Use a test-mode Price ID and set the secret locally;
# never commit STRIPE_SECRET_KEY. This does not enable real sales or downloads.
NEXTINSTOCK_TEST_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_DESKTOP_PRICE_ID=
STRIPE_CHECKOUT_ICON_FILE_ID=
NEXTINSTOCK_PROMO_CODES_ENABLED=false
NEXTINSTOCK_PUBLIC_URL=http://127.0.0.1:3000

# Live sales require a reviewed release, verified email sender, webhook, and the
# launch checks in docs/payment-handoff.md. Pausing sales keeps past downloads available.
NEXTINSTOCK_SALES_ENABLED=false
STRIPE_DESKTOP_OFFER_PRICE_ID=
NEXTINSTOCK_DESKTOP_OFFER_TOTAL=
NEXTINSTOCK_DESKTOP_OFFER_REMAINING=
NEXTINSTOCK_RELEASE_URL=
BLOB_READ_WRITE_TOKEN=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
NEXTINSTOCK_DELIVERY_FROM="Nextinstock <nextinstock@grayshapes.com>"
NEXTINSTOCK_SUPPORT_EMAIL=nextinstock@grayshapes.com
